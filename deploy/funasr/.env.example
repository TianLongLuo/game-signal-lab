FUNASR_VERSION=1.4.0
FUNASR_HOST_PORT=8000
FUNASR_DEVICE=cpu
# SenseVoiceSmall supports Chinese + English with automatic language detection.
FUNASR_MODEL=sensevoice
FUNASR_LANGUAGE=auto
FUNASR_HUB=ms
FUNASR_CPU_THREADS=2
FUNASR_CPU_LIMIT=1.75
FUNASR_MEMORY_LIMIT=2500m
FUNASR_MEMORY_RESERVATION=1500m

# GAME runtime configuration (these variables belong in
# /etc/game-signal-lab/game.env, not in this Docker Compose file).
# The compose service above exposes the OpenAI-compatible HTTP API:
# FUNASR_TRANSPORT=http
# FUNASR_BASE_URL=http://127.0.0.1:8000
# FUNASR_LANGUAGE=auto

# If the server already runs the older paraformer-online WebSocket runtime,
# use this block in game.env instead of FUNASR_BASE_URL. It is a Chinese-only
# streaming path; use the HTTP SenseVoice service above when English is needed.
# Port 10095 is the runtime's usual loopback port; verify it with ss on the
# production host.
# FUNASR_TRANSPORT=websocket
# FUNASR_WS_URL=ws://127.0.0.1:10095
# FUNASR_WS_MODE=2pass
# FUNASR_WS_CHUNK_SIZE=5,10,5
# FUNASR_WS_CHUNK_INTERVAL=10

# FUNASR_TIMEOUT_MS=20000
# FUNASR_MAX_CONCURRENCY=1
# No external speech-provider fallback.
